From 3c9485b23352b9154496d2d87e73b33563da15de Mon Sep 17 00:00:00 2001
From: Andrey Stoyan <andrey.stoyan.csam@gmail.com>
Date: Sun, 23 Aug 2026 13:09:07 +0300
Subject: [PATCH 32/43] test(chexc): assumption imports reach covariant
 function values

The field and bound-method cases are the discriminating ones: before the rule they produced no
diagnostic at all, since the declared type of a function-typed field carries no list. The test
asserts the two locations, not just the message.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../assume/assume_covariant_neg.cj            | 43 +++++++++++++++++++
 .../assume/legacy_callbacks.cj                | 18 ++++++++
 2 files changed, 61 insertions(+)
 create mode 100644 testsuites/LLT/compiler/CheckedExceptions/assume/assume_covariant_neg.cj
 create mode 100644 testsuites/LLT/compiler/CheckedExceptions/assume/legacy_callbacks.cj

diff --git a/testsuites/LLT/compiler/CheckedExceptions/assume/assume_covariant_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_covariant_neg.cj
new file mode 100644
index 0000000000..14d59508cd
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_covariant_neg.cj
@@ -0,0 +1,43 @@
+// Checked exceptions (assumption imports): the assumed list reaches every functional value the
+// dependency hands out in a covariant position -- a call's result, a function-typed field, a
+// method taken as a value -- not only the calls that resolve into the package. Reading such a
+// value out of the package is what pays the obligation here; the text puts the list on the type
+// instead, which would pay it at the eventual call (recorded as an implementation artifact).
+//
+// The field and bound-method cases are what discriminate: before the rule existed neither
+// produced any diagnostic at all, since the declared type of 'worker' carries no list.
+
+// DEPENDENCE: legacy_callbacks.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt legacy_callbacks.cj -o legacy_callbacks.%middle
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions legacy_callbacks.%middle %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: Cannot find a capability for 'Class-LegacyException'
+// ASSERT: scan assume_covariant_neg.cj:30:13
+// ASSERT: scan assume_covariant_neg.cj:37:13
+
+@AssumeThrows[LegacyException]
+import legacy_callbacks.*
+
+// The result of a call into the package.
+public func fromResult(): Int64
+throws () {
+    let w = getWorker()
+    return w()
+}
+
+// A function-typed field of one of its types.
+public func fromField(r: Registry): Int64
+throws () {
+    let w = r.worker
+    return w()
+}
+
+// One of its methods taken as a value.
+public func fromBoundMethod(r: Registry): Int64
+throws () {
+    let m = r.direct
+    return m()
+}
+
+main(): Int64 {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/assume/legacy_callbacks.cj b/testsuites/LLT/compiler/CheckedExceptions/assume/legacy_callbacks.cj
new file mode 100644
index 0000000000..46057d1f25
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/assume/legacy_callbacks.cj
@@ -0,0 +1,18 @@
+// A dependency compiled WITHOUT checking, handing out functions: the assumption over it has to
+// reach the values it returns, not only the calls that return them.
+
+package legacy_callbacks
+
+public class LegacyException <: Exception {}
+
+public func getWorker(): () -> Int64 {
+    return { => throw LegacyException() }
+}
+
+public class Registry {
+    public let worker: () -> Int64
+    public init() {
+        worker = { => throw LegacyException() }
+    }
+    public func direct(): Int64 { 1 }
+}
-- 

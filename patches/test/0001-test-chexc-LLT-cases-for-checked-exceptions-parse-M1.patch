diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/overload_functype_dup.cj b/testsuites/LLT/compiler/CheckedExceptions/types/overload_functype_dup.cj
new file mode 100644
index 0000000000..f7f2ad3d9d
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/overload_functype_dup.cj
@@ -0,0 +1,22 @@
+// Checked exceptions (§3.7): parameter function types differing only in capability
+// lists are the same type for overload purposes — such overloads are duplicates.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class AException <: Exception {}
+
+func h(block: () throws AException -> Unit) {
+    try {
+        block()
+    } catch (e: AException) {
+    }
+}
+
+func h(block: () -> Unit) {
+    block()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/override_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/types/override_neg.cj
new file mode 100644
index 0000000000..fbf5721a0a
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/override_neg.cj
@@ -0,0 +1,25 @@
+// Checked exceptions (§3.8): an override may not require capabilities the
+// original does not provide for.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+open class P {
+    public open func m(): Unit throws AException {
+        throw AException()
+    }
+}
+
+class C1 <: P {
+    // BException is not a subtype of any entry in P.m's list
+    public override func m(): Unit throws AException, BException {
+        throw BException()
+    }
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/override_positive.cj b/testsuites/LLT/compiler/CheckedExceptions/types/override_positive.cj
new file mode 100644
index 0000000000..2452d57968
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/override_positive.cj
@@ -0,0 +1,55 @@
+// Checked exceptions (§3.8): an override's throws list must be pointwise subsumed
+// by the original's — subsets and subtype entries are legal.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+open class BaseException <: Exception {}
+class AException <: BaseException {}
+class BException <: Exception {}
+class CException <: Exception {}
+
+interface I {
+    func f(): Unit throws BException, CException
+    func g(): Unit throws BaseException
+}
+
+open class P {
+    public open func m(): Unit throws BaseException, BException {
+        throw BaseException()
+    }
+}
+
+class C1 <: P & I {
+    // subset of the interface's list
+    public func f(): Unit throws BException {
+        throw BException()
+    }
+    // subtype entry: AException <: BaseException
+    public func g(): Unit throws AException {
+        throw AException()
+    }
+    // override with a subset
+    public override func m(): Unit throws BException {
+        throw BException()
+    }
+}
+
+main() {
+    let c = C1()
+    let i: I = c
+    let p: P = c
+    try {
+        i.f()
+    } catch (e: Exception) {
+    }
+    try {
+        i.g()
+    } catch (e: Exception) {
+    }
+    try {
+        p.m()
+    } catch (e: Exception) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/subtype_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/types/subtype_neg.cj
new file mode 100644
index 0000000000..8bf83ce528
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/subtype_neg.cj
@@ -0,0 +1,22 @@
+// Checked exceptions (§3.4): narrowing a capability list is NOT a subtype —
+// the target type must cover every capability the source function requires.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func f() throws AException, BException {
+    throw AException()
+}
+
+main() {
+    // f requires a BException capability; the target type provides only AException
+    let g: () throws AException -> Unit = f
+    try {
+        g()
+    } catch (e: Exception) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/subtype_positive.cj b/testsuites/LLT/compiler/CheckedExceptions/types/subtype_positive.cj
new file mode 100644
index 0000000000..ffb436ff54
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/subtype_positive.cj
@@ -0,0 +1,36 @@
+// Checked exceptions (§3.4): functional-type subtyping — capability lists compare
+// as sets: permutations, adding requirements, and pointwise widening are all legal.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+open class BaseException <: Exception {}
+class AException <: BaseException {}
+class BException <: Exception {}
+class CException <: Exception {}
+
+func f() throws AException, BException {
+    throw AException()
+}
+
+main() {
+    // permutation: capability lists are sets
+    let f1: () throws (BException, AException) -> Unit = f
+    // adding requirements is ok — call sites just provide more
+    let f2: () throws (AException, BException, CException) -> Unit = f
+    // pointwise widening: CanThrow<BaseException> is suitable for CanThrow<AException>
+    let f3: () throws (BaseException, BException) -> Unit = f
+    try {
+        f1()
+    } catch (e: Exception) {
+    }
+    try {
+        f2()
+    } catch (e: Exception) {
+    }
+    try {
+        f3()
+    } catch (e: Exception) {
+    }
+    return 0
+}

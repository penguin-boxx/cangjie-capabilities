+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: '...' is not allowed in a function type's 'throws' clause
+
+class AException <: Exception {}
+
+var f: () throws (AException, ...) -> Unit = { => () }
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/neg_missing_arrow.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_missing_arrow.cj
new file mode 100644
index 0000000000..c066183b01
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_missing_arrow.cj
@@ -0,0 +1,13 @@
+// Checked exceptions (§3.4): a functional type's `throws` clause must be followed
+// by `->`; `(A) throws (E)` without an arrow is a parse error.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: expected '->' after 'throws' clause in function type
+
+class AException <: Exception {}
+
+var f: (Int64) throws (AException) = 0
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/type_functional.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/type_functional.cj
new file mode 100644
index 0000000000..80d5317e4a
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/type_functional.cj
@@ -0,0 +1,51 @@
+// Checked exceptions (§3.4): `throws` clauses in functional types.
+// Forms: parenthesised list, single-type sugar, empty list, right-associative nesting.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+class TimeoutException <: Exception {}
+
+func mayThrowA() throws AException {
+    throw AException()
+}
+
+func mayThrowAB() throws AException, BException {
+    throw BException()
+}
+
+// parenthesised list
+var f1: () throws (AException, BException) -> Unit = mayThrowAB
+
+// single capability: parens optional
+var f2: () throws AException -> Unit = mayThrowA
+
+// empty capability list: same type as omitting the clause
+var f3: () throws () -> Unit = { => () }
+var f4: () -> Unit = { => () }
+
+// clause in a parameter's type
+func caller(g: () throws AException -> Unit): Unit throws AException {
+    g()
+}
+
+// right-associative nesting: function returning a throwing function
+func mk(): () throws TimeoutException -> Unit throws () {
+    { => throw TimeoutException() }
+}
+
+main() {
+    try {
+        caller(mayThrowA)
+        f1()
+        f2()
+        let h: () throws TimeoutException -> Unit = mk()
+        h()
+    } catch (e: Exception) {
+    }
+    f3()
+    f4()
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/generics_explicit.cj b/testsuites/LLT/compiler/CheckedExceptions/types/generics_explicit.cj
new file mode 100644
index 0000000000..c832958536
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/generics_explicit.cj
@@ -0,0 +1,29 @@
+// Checked exceptions (§3.6): clause types may be/contain type parameters; capability
+// argument inference follows type-argument inference (explicit args work).
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+
+func safeThrow<E>(e: E): Nothing where E <: Exception throws E {
+    throw e
+}
+
+func eqOrThrow<T, E>(x: T, y: T, mkE: () -> E): Unit
+where T <: Equatable<T>, E <: Exception
+throws E {
+    if (x != y) {
+        throw mkE()
+    }
+}
+
+main() {
+    try {
+        eqOrThrow<Int64, AException>(1, 1, { => AException() })
+        safeThrow<AException>(AException())
+    } catch (e: AException) {
+        return 0
+    }
+    return 1
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/generics_no_inference.cj b/testsuites/LLT/compiler/CheckedExceptions/types/generics_no_inference.cj
new file mode 100644
index 0000000000..114f472e0d
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/generics_no_inference.cj
@@ -0,0 +1,25 @@
+// Checked exceptions (§3.6): capability parameters of argument functions are NOT
+// considered in type-argument inference (no row unification).
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class AException <: Exception {}
+
+func f() throws AException {
+    throw AException()
+}
+
+func g<T, G>(x: Int64, block: () throws (T, G) -> Unit)
+where T <: Exception, G <: Exception {
+    try {
+        block()
+    } catch (e: Exception) {
+    }
+}
+
+main() {
+    // T and G cannot be inferred from f's capability list
+    g(0, f)
+    return 0
+}

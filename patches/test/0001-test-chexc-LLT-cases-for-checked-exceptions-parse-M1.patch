diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/decl_functions.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_functions.cj
new file mode 100644
index 0000000000..68377a87d0
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_functions.cj
@@ -0,0 +1,54 @@
+// Checked exceptions (§3.2): `throws` clauses on top-level function declarations.
+// Positive: all forms parse and the program compiles and runs.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+// single entry
+func f1() throws AException {
+    throw AException()
+}
+
+// multiple entries
+func f2() throws AException, BException {
+    f1()
+    throw BException()
+}
+
+// empty clause: requires no capabilities from call sites
+func f3() throws () {
+    try {
+        f1()
+    } catch (e: AException) {
+    }
+}
+
+// throws before where
+func g1<T>(x: T): Unit throws AException where T <: ToString {
+    throw AException()
+}
+
+// where before throws
+func g2<T>(x: T): Unit where T <: ToString throws AException {
+    throw AException()
+}
+
+// generic exception type in the clause
+func gThrow<E>(e: E): Nothing where E <: Exception throws E {
+    throw e
+}
+
+main() {
+    try {
+        f2()
+        g1<Int64>(1)
+        g2<Int64>(2)
+        gThrow<AException>(AException())
+    } catch (e: Exception) {
+    }
+    f3()
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/decl_main.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_main.cj
new file mode 100644
index 0000000000..f288638a56
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_main.cj
@@ -0,0 +1,14 @@
+// Checked exceptions (§3.2): `main` may carry a `throws` clause — the listed
+// exceptions are handled by the default exception handler.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class QException <: Exception {}
+
+main() throws QException {
+    if (false) {
+        throw QException()
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/decl_members.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_members.cj
new file mode 100644
index 0000000000..d93ef5fb76
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_members.cj
@@ -0,0 +1,79 @@
+// Checked exceptions (§3.2): `throws` clauses on members — methods, static methods,
+// constructors, property accessors, operators, interface methods, extension methods.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class MException <: Exception {}
+class CreationException <: Exception {}
+class GException <: Exception {}
+class SException <: Exception {}
+
+interface I {
+    func m(): Int64 throws MException
+}
+
+class C <: I {
+    var val: Int64 = 0
+
+    init() throws CreationException {
+        this.val = 1
+    }
+
+    init(x: Int64) throws CreationException {
+        this.val = x
+    }
+
+    public func m(): Int64 throws MException {
+        if (val < 0) {
+            throw MException()
+        }
+        val
+    }
+
+    static func sm(): Unit throws AException {
+        throw AException()
+    }
+
+    prop p: Int64 {
+        get() throws GException {
+            val
+        }
+    }
+
+    mut prop q: Int64 {
+        get() throws GException {
+            val
+        }
+        set(v) throws SException {
+            val = v
+        }
+    }
+
+    operator func +(that: C): C throws AException {
+        C(this.val + that.val)
+    }
+}
+
+extend C {
+    func extMethod(): Int64 throws AException {
+        if (val > 100) {
+            throw AException()
+        }
+        val
+    }
+}
+
+main() {
+    try {
+        let c = C(41)
+        let d = C(1)
+        let s = c + d
+        let x = s.m() + s.p + s.extMethod()
+        s.q = x
+        C.sm()
+    } catch (e: Exception) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_rejected.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_rejected.cj
new file mode 100644
index 0000000000..ba6f5fb413
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_rejected.cj
@@ -0,0 +1,15 @@
+// Guard: WITHOUT --enable-chexc, `throws`-clause syntax is not available;
+// a declaration using it must fail to compile.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class AException <: Exception {}
+
+func f() throws AException {
+    throw AException()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_identifier.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_identifier.cj
new file mode 100644
index 0000000000..745f3327c7
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_identifier.cj
@@ -0,0 +1,22 @@
+// Guard: WITHOUT --enable-chexc, `throws` remains an ordinary identifier —
+// existing code that uses it as a name must keep compiling unchanged.
+
+// EXEC: %compiler %cmp_opt %n.cj -o %output
+// EXEC: %run %output
+
+func throws(x: Int64): Int64 {
+    x + 1
+}
+
+class C {
+    var throws: Int64 = 0
+}
+
+main() {
+    let c = C()
+    c.throws = throws(41)
+    if (c.throws != 42) {
+        return 1
+    }
+    return 0
+}

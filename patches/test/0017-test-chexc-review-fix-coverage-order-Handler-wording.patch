diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.cj
new file mode 100644
index 0000000000..98b3f8ed7e
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.cj
@@ -0,0 +1,11 @@
+// Effects (review finding F1): a 'performs' clause change must invalidate the incremental
+// cache like a 'throws' change does. The second build changes ONLY risky's clause; the caller
+// is untouched, so a stale hash would leave the new requirement undemanded at its call site.
+
+// DEPENDENCE: %n.old.cj %n.new.cj
+
+// EXEC: %compiler %incrementalCompile %cmp_opt %enableEH --enable-checked-exceptions %n.old.cj -o %output
+// EXEC: %rmfile %n.old.cj
+// EXEC: %cpfile %n.new.cj %n.old.cj
+// EXEC-PIPE-1: %compiler %incrementalCompile %cmp_opt %enableEH --enable-checked-exceptions %n.old.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetNumber'
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.new.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.new.cj
new file mode 100644
index 0000000000..b28789708a
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_performs.new.cj
@@ -0,0 +1,15 @@
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+
+public func risky(): Int64 performs GetNumber {
+    return 0
+}
+
+public func caller(): Int64 {
+    return risky() // must now error: caller supplies no GetNumber handler
+}
+
+main() {
+    return 0
+}

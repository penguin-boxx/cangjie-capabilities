diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/libeff.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/libeff.cj
new file mode 100644
index 0000000000..ae51752ffa
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/libeff.cj
@@ -0,0 +1,12 @@
+// Support package for the cross-package effect tests: a checked dependency whose public surface
+// carries a 'performs' clause, so the effect requirement must cross through the .cjo.
+
+package libeff
+
+import stdx.effect.*
+
+public class GetToken <: Command<Int64> {}
+
+public func fetch(): Int64 performs GetToken {
+    return perform GetToken()
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic.cj
new file mode 100644
index 0000000000..4dc74bf316
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic.cj
@@ -0,0 +1,25 @@
+// Effects (§8.2 with §3.7): a generic command in a 'performs' clause is instantiated at the
+// call site, and a handler for exactly that instantiation discharges it.
+
+// EXEC: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+import stdx.effect.*
+
+class GenCmd<T> <: Command<T> {}
+
+func gen<T>(): T performs GenCmd<T> {
+    return perform GenCmd<T>()
+}
+
+main() {
+    let r = try {
+        gen<Int64>()
+    } handle (_: GenCmd<Int64>) {
+        resume with 5
+    }
+    if (r != 5) {
+        return 1
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic_neg.cj
new file mode 100644
index 0000000000..644e7afd7c
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_generic_neg.cj
@@ -0,0 +1,25 @@
+// Effects (§8.2 with §3.7): the instantiated demand names the instantiated command type — a
+// handler for a different instantiation does not discharge it.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GenCmd<Int64>'
+
+import stdx.effect.*
+
+class GenCmd<T> <: Command<T> {}
+
+func gen<T>(): T performs GenCmd<T> {
+    return perform GenCmd<T>()
+}
+
+public func bad(): Int64 {
+    return try {
+        gen<Int64>()
+    } handle (_: GenCmd<Rune>) {
+        resume with r'x'
+    }
+}
+
+main() {
+    return 0
+}

diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_order_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_order_neg.cj
new file mode 100644
index 0000000000..7b624860cc
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_order_neg.cj
@@ -0,0 +1,18 @@
+// Effects (§9.1 rule 8): the clause order is fixed — 'performs' precedes 'throws'. The reverse
+// order is rejected, not silently accepted.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan must precede
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+class MyExc <: Exception {}
+
+func wrongOrder(): Int64 throws MyExc performs GetNumber {
+    return 0
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg.cj
new file mode 100644
index 0000000000..3f5b22767f
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg.cj
@@ -0,0 +1,22 @@
+// Effects (§8.2 with §3.10.2): a 'performs' requirement crosses the package boundary — the
+// entries live in the functional type's capability list, which the .cjo carries.
+
+// DEPENDENCE: libeff.cj
+// EXEC: %compiler %cmp_opt %enableEH %compile_lib_opt --enable-checked-exceptions libeff.cj -o libeff.%middle
+// EXEC: %compiler %cmp_opt %enableEH --enable-checked-exceptions libeff.%middle %n.cj -o %output
+// EXEC: %run %output
+
+import stdx.effect.*
+import libeff.*
+
+main() {
+    let r = try {
+        fetch()
+    } handle (_: GetToken) {
+        resume with 7
+    }
+    if (r != 7) {
+        return 1
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg_neg.cj
new file mode 100644
index 0000000000..759584cd18
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_xpkg_neg.cj
@@ -0,0 +1,18 @@
+// Effects (§8.2 with §3.10.2): an imported, unhandled effect requirement is a missing
+// capability — and it is not inferred even here, since effect requirements never are.
+
+// DEPENDENCE: libeff.cj
+// EXEC: %compiler %cmp_opt %enableEH %compile_lib_opt --enable-checked-exceptions libeff.cj -o libeff.%middle
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions libeff.%middle %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetToken'
+
+import stdx.effect.*
+import libeff.*
+
+func unhandled(): Int64 {
+    return fetch()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.cj
new file mode 100644
index 0000000000..436c76d934
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.cj
@@ -0,0 +1,12 @@
+// Checked exceptions (ledger C2, second direction): a CALLEE's clause change must invalidate its
+// unchanged CALLERS. incr_caps covers the caller-changed direction; this covers callee-changed —
+// the direction where a clause-only change used to classify as a 'body' change and spreading
+// stopped at the declaration itself (DeclHash.sig did not cover the clauses).
+
+// DEPENDENCE: %n.old.cj %n.new.cj
+
+// EXEC: %compiler %incrementalCompile %cmp_opt --enable-checked-exceptions %n.old.cj -o %output
+// EXEC: %rmfile %n.old.cj
+// EXEC: %cpfile %n.new.cj %n.old.cj
+// EXEC-PIPE-1: %compiler %incrementalCompile %cmp_opt --enable-checked-exceptions %n.old.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-IncrExc2'
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.new.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.new.cj
new file mode 100644
index 0000000000..d1370feb5f
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps2.new.cj
@@ -0,0 +1,13 @@
+class IncrExc2 <: Exception {}
+
+public func risky2(): Int64 throws IncrExc2 {
+    return 0
+}
+
+public func caller2(): Int64 {
+    return risky2() // callee clause is new; this unchanged caller must be re-checked
+}
+
+main() {
+    return 0
+}

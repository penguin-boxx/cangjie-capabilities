+    return 0
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_kinds_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_kinds_neg.cj
new file mode 100644
index 0000000000..67410d4bc7
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_kinds_neg.cj
@@ -0,0 +1,34 @@
+// Effects (§8.2 with §9.1): the two capability kinds never discharge one another. A 'catch'
+// supplies exception capabilities only, and a 'handle' supplies effect capabilities only, because
+// discharge is by subtyping and the 'Command' and 'Exception' roots are disjoint.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-eh --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetNumber'
+// ASSERT: scan Cannot find a capability for 'Class-MyException'
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+class MyException <: Exception {}
+
+// a catch cannot discharge a perform
+public func caughtNotHandled(): Int64 {
+    return try {
+        perform GetNumber()
+    } catch (e: Exception) {
+        0
+    }
+}
+
+// a handle cannot discharge a throw
+public func handledNotCaught(): Int64 {
+    return try {
+        throw MyException()
+    } handle (_: GetNumber, r: Resumption<Int64>) {
+        resume r with 0
+    }
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_neg.cj
new file mode 100644
index 0000000000..6841a36456
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_neg.cj
@@ -0,0 +1,19 @@
+// Effects (§8.2): an undeclared, unhandled 'perform' is a missing capability — and unlike an
+// exception requirement it is never inferred (§9.1 policy table), so this is an error even though
+// the function is not part of the exported surface.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-eh --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetNumber'
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+
+// internal and clause-free: an EXCEPTION requirement would be inferred here, an effect one is not
+func undeclared(): Int64 {
+    return perform GetNumber()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.cj
new file mode 100644
index 0000000000..2cba5460e3
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.cj
@@ -0,0 +1,11 @@
+// Checked exceptions (ledger C2): capability lists must survive the INCREMENTAL compilation
+// cache. The first build caches 'risky' with its clause; the second build changes only 'ok', so
+// 'risky' is served from the cache — and its requirement must still be demanded at the call site.
+
+// DEPENDENCE: %n.old.cj %n.new.cj
+
+// EXEC: %compiler %incrementalCompile %cmp_opt --enable-checked-exceptions %n.old.cj -o %output
+// EXEC: %rmfile %n.old.cj
+// EXEC: %cpfile %n.new.cj %n.old.cj
+// EXEC-PIPE-1: %compiler %incrementalCompile %cmp_opt --enable-checked-exceptions %n.old.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-IncrExc'
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.new.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.new.cj
new file mode 100644
index 0000000000..cffe57a4b9
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.new.cj
@@ -0,0 +1,14 @@
+class IncrExc <: Exception {}
+
+public func risky(): Int64 throws IncrExc {
+    throw IncrExc()
+}
+
+// The clause is gone in this version: the call to the CACHED 'risky' must still demand IncrExc.
+public func ok(): Int64 {
+    return risky()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.old.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.old.cj
new file mode 100644
index 0000000000..a3ceccc908
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/incr_caps.old.cj
@@ -0,0 +1,15 @@
+class IncrExc <: Exception {}
+
+// Unchanged between the two versions: on the second (incremental) build its type is served from
+// the cache, so its capability list must have survived the round trip.
+public func risky(): Int64 throws IncrExc {
+    throw IncrExc()
+}
+
+public func ok(): Int64 throws IncrExc {
+    return risky()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/libx.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/libx.cj
new file mode 100644
index 0000000000..96e9fbcbe8
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/libx.cj
@@ -0,0 +1,65 @@
+// Support package for the cross-package tests (proposal 3.10.2): a CHECKED dependency whose
+// public surface carries 'throws' clauses. Compiled with --enable-checked-exceptions, so its
+// capability lists must survive into the .cjo and be demanded at call sites in other packages.
+
+package libx
+
+public class XException <: Exception {}
+public class YException <: Exception {}
+public class GenException<T> <: Exception {}
+
+public func query(sql: String): Int64 throws XException {
+    if (sql.size == 0) {
+        throw XException()
+    }
+    return sql.size
+}
+
+public func clean(): Int64 throws () {
+    return 1
+}
+
+public func generic<T>(x: T): Int64 throws GenException<T> {
+    return 1
+}
+
+public class Connection {
+    public init() {
+    }
+
+    public func execute(sql: String): Int64 throws XException {
+        return sql.size
+    }
+
+    public prop status: Int64 {
+        get() throws YException {
+            0
+        }
+    }
+}
+
+// A public signature carrying a functional type with a clause (proposal 3.4): the clause is part
+// of the parameter's TYPE, so it must survive in the .cjo nested inside that type.
+public func withCallback(cb: () throws XException -> Int64): Int64 throws XException {
+    return cb()
+}
+
+// A capturing class (proposal 3.9): construction demands the captured capabilities, so the
+// 'captures' clause must cross the boundary as well.
+public class Session captures XException {
+    public init() {
+    }
+
+    public func run(): Int64 {
+        throw XException()
+    }
+}
+
+// Proposal 3.10.2 rule 1: the exported list is canonical — subsumed entries dropped. 'SubExc' is
+// covered by 'BaseExc', so importers see 'BaseExc' alone.
+public open class BaseExc <: Exception {}
+public class SubExc <: BaseExc {}
+
+public func subsumed(): Int64 throws SubExc, BaseExc {
+    return 1
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_basic.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_basic.cj
new file mode 100644
index 0000000000..6ae20199d3
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_basic.cj
@@ -0,0 +1,33 @@
+// Checked exceptions (§3.10.2): a 'throws' clause on a public declaration must cross the package
+// boundary through the .cjo, so a call in another package demands the same capabilities.
+
+// DEPENDENCE: libx.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt --experimental --enable-checked-exceptions libx.cj -o libx.%middle
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions libx.%middle %n.cj -o %output
+// EXEC: %run %output
+
+import libx.*
+
+// The imported requirement is dischargeable by a clause of our own...
+func viaClause(): Int64 throws XException {
+    return query("select 1")
+}
+
+main() {
+    // ... and by a try-catch here.
+    try {
+        let a = query("select 1")
+        let b = viaClause()
+        let c = Connection().execute("select 2")
+        if (a + b + c == 0) {
+            return 1
+        }
+    } catch (e: XException) {
+        return 1
+    }
+    // An authoritative empty clause imports as empty: no capability needed.
+    if (clean() == 0) {
+        return 1
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_canonical_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_canonical_neg.cj
new file mode 100644
index 0000000000..d3a6d4e198
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_canonical_neg.cj
@@ -0,0 +1,20 @@
+// Checked exceptions (§3.10.2 rule 1): the capability list written to the .cjo is in canonical
+// normal form — entries subsumed by another entry are dropped, so an importer of
+// 'throws SubExc, BaseExc' sees 'BaseExc' alone and gets ONE diagnostic, not two. Dropping the
+// subsumed entry loses no obligation: any supply discharging 'BaseExc' discharges 'SubExc' too.
+
+// DEPENDENCE: libx.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt --experimental --enable-checked-exceptions libx.cj -o libx.%middle
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions libx.%middle %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-BaseExc'
+// ASSERT: scan 1 error generated
+
+import libx.*
+
+public func bad(): Int64 {
+    return subsumed() // one missing capability: the canonical list holds only BaseExc
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_captures_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_captures_neg.cj

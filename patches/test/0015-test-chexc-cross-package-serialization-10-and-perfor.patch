+
+// DEPENDENCE: libx.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt --experimental --enable-checked-exceptions libx.cj -o libx.%middle
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions libx.%middle %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-XException'
+
+import libx.*
+
+public func build(): Int64 {
+    let s = Session() // error: constructing a capturing class demands XException
+    return s.run()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_captures_pos.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_captures_pos.cj
new file mode 100644
index 0000000000..62e820a0ee
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_captures_pos.cj
@@ -0,0 +1,19 @@
+// Checked exceptions (§3.9 with §3.10.2): the imported captures requirement is discharged at the
+// construction site, and the instance's methods then need no capability of their own.
+
+// DEPENDENCE: libx.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt --experimental --enable-checked-exceptions libx.cj -o libx.%middle
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions libx.%middle %n.cj -o %output
+// EXEC: %run %output
+
+import libx.*
+
+main() {
+    try {
+        let s = Session() // discharged here
+        s.run()
+        return 1
+    } catch (e: XException) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_functype.cj b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_functype.cj
new file mode 100644
index 0000000000..76e5ec1ea9
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/serialization/xpkg_functype.cj
@@ -0,0 +1,21 @@
+// Checked exceptions (§3.4 with §3.10.2): a clause on a FUNCTIONAL TYPE is part of the type, so
+// it must survive nested inside an imported signature — the lambda passed here is covered by the
+// parameter type's capability list and may throw without a try of its own.
+
+// DEPENDENCE: libx.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt --experimental --enable-checked-exceptions libx.cj -o libx.%middle
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions libx.%middle %n.cj -o %output
+// EXEC: %run %output
+
+import libx.*
+
+main() {
+    try {
+        // The literal's capability list comes from the expected type (proposal 3.5), which the
+        // .cjo must have carried across: the body may throw XException with no local handler.
+        withCallback({ => throw XException() })
+        return 1
+    } catch (e: XException) {
+    }
+    return 0
+}

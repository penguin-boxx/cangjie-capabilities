diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/covered_meet.cj b/testsuites/LLT/compiler/CheckedExceptions/types/covered_meet.cj
new file mode 100644
index 0000000000..6521c560d3
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/covered_meet.cj
@@ -0,0 +1,34 @@
+// Checked exceptions ("Joins and meets"): the meet of two lists keeps what both cover -- of two
+// comparable entries, the more specific one. So a callback accepted by both branches may require
+// the narrower exception, and calling the joined function with such a callback is legal.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+open class BaseE <: Exception {}
+class DerE <: BaseE {}
+
+func takesBase(callback: () throws BaseE -> Unit): Unit {
+    try {
+        callback()
+    } catch (e: BaseE) {
+        ()
+    }
+}
+
+func takesDer(callback: () throws DerE -> Unit): Unit {
+    try {
+        callback()
+    } catch (e: DerE) {
+        ()
+    }
+}
+
+main(): Int64 {
+    let cond = true
+    let k = if (cond) { takesBase } else { takesDer }
+    // the meet of 'throws BaseE' and 'throws DerE' is 'throws DerE': the narrower one, which both
+    // parameter types accept
+    k({ => throw DerE() })
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/join_meet.cj b/testsuites/LLT/compiler/CheckedExceptions/types/join_meet.cj
new file mode 100644
index 0000000000..aca41f243d
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/join_meet.cj
@@ -0,0 +1,29 @@
+// Checked exceptions ("Joins and meets"): where the language computes a common supertype of
+// functional types componentwise, the capability component of the JOIN is the union of the lists
+// in semantic form; the MEET -- which the join's parameter positions require by contravariance --
+// keeps the entries both lists cover, so unrelated entries contribute nothing and the common
+// parameter type is requirement-free. Both examples are the text's own.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan found '() throws (Class-AException, Class-BException) -> Unit'
+// ASSERT: scan found '(() -> Unit) -> Unit'
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func g(): Unit throws AException {}
+func h(): Unit throws BException {}
+
+func p(callback: () throws AException -> Unit): Unit {}
+func q(callback: () throws BException -> Unit): Unit {}
+
+main(): Int64 {
+    let cond = true
+    // join: the union of the two lists
+    let f = if (cond) { g } else { h }
+    let showJoin: Int64 = f
+    // meet: unrelated entries have no common subtype, so the parameter is requirement-free
+    let k = if (cond) { p } else { q }
+    let showMeet: Int64 = k
+    return 0
+}

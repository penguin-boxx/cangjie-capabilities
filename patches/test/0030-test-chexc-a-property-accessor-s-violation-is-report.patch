From 61939383c58fbaae65a296c3362c4beeab5d0559 Mon Sep 17 00:00:00 2001
From: Andrey Stoyan <andrey.stoyan.csam@gmail.com>
Date: Sun, 23 Aug 2026 09:43:58 +0300
Subject: [PATCH 30/43] test(chexc): a property accessor's violation is
 reported against the property

Pins the shape that crashed the compiler: an interface property, whose accessor the compiler
generates without a position, implemented by an accessor that infers a capability the interface's
does not have.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../scopes/warn_prop_accessor_override.cj     | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 testsuites/LLT/compiler/CheckedExceptions/scopes/warn_prop_accessor_override.cj

diff --git a/testsuites/LLT/compiler/CheckedExceptions/scopes/warn_prop_accessor_override.cj b/testsuites/LLT/compiler/CheckedExceptions/scopes/warn_prop_accessor_override.cj
new file mode 100644
index 0000000000..b38e72bc55
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/scopes/warn_prop_accessor_override.cj
@@ -0,0 +1,35 @@
+// Checked exceptions (diagnostics on property accessors): an accessor declared without a body --
+// as in an interface, or as a field-like property -- is generated by the compiler and has no
+// position of its own, and its identifier is synthesized ('$valueget'). A diagnostic about it is
+// reported against the property the author wrote. Attaching one to the accessor instead crashed
+// the compiler ("begin of range is zero") on any package where an implementation's accessor
+// inferred a capability the interface's accessor did not have -- stdx.net.http, for one.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc=warn %n.cj -o %output 2> warn_out.txt
+// EXEC: %run %output
+// EXEC-PIPE: cat warn_out.txt | compare %f
+// ASSERT: scan warning: exception type 'Class-AException' in 'throws' clause of 'value' is not covered
+// ASSERT: scan prop value: Int64
+
+class AException <: Exception {}
+
+interface HasValue {
+    prop value: Int64
+}
+
+class Impl <: HasValue {
+    public prop value: Int64 {
+        get() {
+            throw AException()
+        }
+    }
+}
+
+main(): Int64 {
+    let i: HasValue = Impl()
+    try {
+        return i.value
+    } catch (e: AException) {
+        return 0
+    }
+}

diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/covered_entry_demand.cj b/testsuites/LLT/compiler/CheckedExceptions/types/covered_entry_demand.cj
new file mode 100644
index 0000000000..1e750c43dc
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/covered_entry_demand.cj
@@ -0,0 +1,19 @@
+// Checked exceptions (semantic form): 'throws Base, Derived' with 'Derived <: Base' IS the list
+// {Base} -- the covered entry introduces no requirement. A call site missing the handler reports
+// Base alone, and a 'catch (e: Base)' discharges the whole call.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: Cannot find a capability for 'Class-BaseE' (of type 'CanThrow<Class-BaseE>') in the current scope
+// ASSERT: scan-not Class-DerE
+
+open class BaseE <: Exception {}
+class DerE <: BaseE {}
+
+func f(): Unit throws BaseE, DerE {}
+
+public func caller(): Unit
+throws () {
+    f()
+}
+
+main(): Int64 { 0 }
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/generics_higher_order.cj b/testsuites/LLT/compiler/CheckedExceptions/types/generics_higher_order.cj
index 71f66b42a9..392cdd2bb0 100644
--- a/testsuites/LLT/compiler/CheckedExceptions/types/generics_higher_order.cj
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/generics_higher_order.cj
@@ -35,7 +35,7 @@ func handlingBoth<E>(fn: () throws E -> Unit, witness: E): Int64 where E <: Exce
 }
 
 // a member of a generic class: the mapping comes from the receiver
-class Handler<E> where E <: Exception {
+class CanPerform<E> where E <: Exception {
     func run(fn: () throws E -> Unit): Int64 {
         try {
             fn()
@@ -56,7 +56,7 @@ main(): Int64 {
     if (handlingBoth(thrower, AException()) != 1) {
         return 1
     }
-    if (Handler<AException>().run(thrower) != 1) {
+    if (CanPerform<AException>().run(thrower) != 1) {
         return 1
     }
     return 0
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/unchecked_instantiated_value.cj b/testsuites/LLT/compiler/CheckedExceptions/types/unchecked_instantiated_value.cj
new file mode 100644
index 0000000000..b383d6841d
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/unchecked_instantiated_value.cj
@@ -0,0 +1,24 @@
+// Checked exceptions ("Unchecked types in 'throws' lists"): an entry whose type parameter
+// instantiates to an unchecked exception type vanishes -- '() throws E -> R' with 'E' unchecked
+// IS the clause-free '() -> R'. So the specialized function is assignable wherever the
+// clause-free shape is expected, and calling it through that value demands nothing.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+class ReqExc <: UncheckedException {}
+
+func safeThrow<E>(e: E): Unit where E <: Exception
+throws E {
+    throw e
+}
+
+main(): Int64 {
+    let g: (ReqExc) -> Unit = safeThrow<ReqExc>
+    try {
+        g(ReqExc())
+    } catch (e: ReqExc) {
+        return 0
+    }
+    return 1
+}

diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value.cj
new file mode 100644
index 0000000000..ef72ca356e
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value.cj
@@ -0,0 +1,33 @@
+// Checked exceptions (inference and function values): the positive half of
+// 'infer_ref_value_neg.cj'. Forming the value where the capability is in scope is fine, and the
+// reference is an inference edge -- a function that only REFERENCES an inferred thrower acquires
+// the requirement itself, exactly as a caller would.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+class LeakExc <: Exception {}
+
+func risky(): Unit {
+    throw LeakExc()
+}
+
+// no clause: the reference contributes LeakExc to THIS declaration's inferred list
+func giveWorker(): () -> Unit {
+    risky
+}
+
+main(): Int64 {
+    try {
+        let w: () -> Unit = risky   // the try supplies the capability at formation
+        w()
+    } catch (e: LeakExc) {
+        try {
+            let g = giveWorker()    // giveWorker's own inferred list is supplied here
+            g()
+        } catch (e2: LeakExc) {
+            return 0
+        }
+    }
+    return 1
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value_neg.cj
new file mode 100644
index 0000000000..29d7966b89
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_ref_value_neg.cj
@@ -0,0 +1,26 @@
+// Checked exceptions (inference and function values): a reference that turns an inferred
+// declaration into a value pays the declaration's inferred list at the formation site. Without
+// this, the value's functional type -- formed before inference ran -- carries no list, a call
+// through it demands nothing, and a program with no handler anywhere compiles and leaks at run
+// time (found by review, 2026-08-30). Declared clauses are unaffected: a reference's type
+// carries those. The obligation lands at formation rather than at the eventual call, which is
+// stricter than the text's type-riding reading -- same boundary semantics as assumption imports.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: Cannot find a capability for 'Class-LeakExc'
+// ASSERT: scan infer_ref_value_neg.cj:21:25
+// ASSERT: scan error: Cannot find a capability for 'Class-LeakExc'
+
+class LeakExc <: Exception {}
+
+func risky(): Unit {   // no clause: throws LeakExc by inference
+    throw LeakExc()
+}
+
+main(): Int64 {
+    let w: () -> Unit = risky   // formation site: pays LeakExc
+    w()
+    let u = risky               // and with no annotation too
+    u()
+    return 0
+}

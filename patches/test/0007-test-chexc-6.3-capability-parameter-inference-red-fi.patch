diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_basic.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_basic.cj
new file mode 100644
index 0000000000..8b29b4ff20
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_basic.cj
@@ -0,0 +1,39 @@
+// Checked exceptions (§6.3): non-public callables without a clause get their
+// capability lists inferred from their bodies; discharge removes entries;
+// inferred lists propagate to callers through normal checking.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func g() { // inferred: throws AException
+    throw AException()
+}
+
+func f(): Int64 { // inferred: throws AException, BException
+    g()
+    if (false) {
+        throw BException()
+    }
+    1
+}
+
+func discharged(): Int64 { // inferred: empty — everything handled locally
+    try {
+        f()
+    } catch (e: AException) {
+    } catch (e: BException) {
+    }
+    2
+}
+
+main() {
+    let x = discharged() // callable with empty inferred list: no capability needed
+    try {
+        let _ = f() + x
+    } catch (e: Exception) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_explicit_dots.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_explicit_dots.cj
new file mode 100644
index 0000000000..81b258d506
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_explicit_dots.cj
@@ -0,0 +1,40 @@
+// Checked exceptions (§6.3.5): an explicit clause disables inference (authoritative);
+// `throws A, ...` re-enables it — declared entries union with inferred ones;
+// `throws ()` pins an empty list.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func mixed(n: Int64): Int64 throws AException, ... { // A explicit, B inferred
+    if (n < 0) {
+        throw AException()
+    }
+    if (n == 7) {
+        throw BException()
+    }
+    n
+}
+
+func pinnedEmpty(): Int64 throws () { // authoritative empty: all handled locally
+    try {
+        mixed(7)
+    } catch (e: AException) {
+        0
+    } catch (e: BException) {
+        0
+    }
+}
+
+main() {
+    try {
+        let _ = mixed(1) + pinnedEmpty()
+    } catch (e: AException) {
+        return 1
+    } catch (e: BException) {
+        return 1
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_poly_recursion_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_poly_recursion_neg.cj
new file mode 100644
index 0000000000..02b001deb8
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_poly_recursion_neg.cj
@@ -0,0 +1,28 @@
+// Checked exceptions (§6.3.4): polymorphic recursion over exception-relevant type
+// parameters makes the candidate universe infinite — inference is rejected with
+// an error naming the growing instantiation; explicit clauses are required.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error
+
+class Box<T> {}
+class GenericException<T> <: Exception {}
+
+func f<T>(n: Int64): Int64 {
+    if (n < 0) {
+        throw GenericException<T>()
+    }
+    if (n == 0) {
+        0
+    } else {
+        f<Box<T>>(n - 1) // re-enters at a growing instantiation
+    }
+}
+
+main() {
+    try {
+        let _ = f<Int64>(3)
+    } catch (e: Exception) {
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_public_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_public_neg.cj
new file mode 100644
index 0000000000..dbde7bc5a0
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_public_neg.cj
@@ -0,0 +1,16 @@
+// Checked exceptions (§6.3.1): public declarations are never inferred — their
+// clauses are authoritative (explicit or empty by omission), so an undeclared
+// checked throw in a public function is an error even with inference on.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-AException'
+
+class AException <: Exception {}
+
+public func api() {
+    throw AException() // error: public, no clause, no inference
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/inference/infer_recursion.cj b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_recursion.cj
new file mode 100644
index 0000000000..6035648d82
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/inference/infer_recursion.cj
@@ -0,0 +1,79 @@
+// Checked exceptions (§6.3.4): recursion is inferred via the least fixpoint of
+// the SCC's monotone equations. Covers self-recursion, mutual recursion with
+// PARTIAL discharge inside the cycle (distinguishes fixpoint from naive union),
+// and a mixed cycle with one authoritative explicit member.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+// self-recursion: inferred throws AException
+func countdown(n: Int64): Int64 {
+    if (n < 0) {
+        throw AException()
+    }
+    if (n == 0) {
+        0
+    } else {
+        countdown(n - 1)
+    }
+}
+
+// mutual recursion with partial discharge:
+// pingpong's own B-throw survives; pong discharges A inside the cycle,
+// so the fixpoint gives ping: {A, B}, pong: {B} (naive union would give pong {A, B})
+func ping(n: Int64): Int64 { // inferred: throws AException, BException
+    if (n < 0) {
+        throw AException()
+    }
+    pong(n - 1)
+}
+
+func pong(n: Int64): Int64 { // inferred: throws BException only
+    if (n == 7) {
+        throw BException()
+    }
+    if (n <= 0) {
+        0
+    } else {
+        try {
+            ping(n - 1)
+        } catch (e: AException) {
+            0
+        }
+    }
+}
+
+// mixed cycle: one member carries an authoritative explicit clause
+func loud(n: Int64): Int64 throws AException { // explicit, checked as written
+    quiet(n)
+}
+
+func quiet(n: Int64): Int64 { // inferred: throws AException (from calling loud)
+    if (n <= 0) {
+        0
+    } else {
+        loud(n - 1)
+    }
+}
+
+main() {
+    try {
+        let a = countdown(3)
+        let b = pong(20)
+        let c = quiet(2)
+        if (a + b + c != 0) {
+            return 1
+        }
+    } catch (e: Exception) {
+        return 1
+    }
+    // pong must be callable with only a BException handler (fixpoint, not union)
+    try {
+        let _ = pong(8)
+    } catch (e: BException) {
+    }
+    return 0
+}

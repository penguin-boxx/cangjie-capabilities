diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/decl_multiple_clauses.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/decl_multiple_clauses.cj
deleted file mode 100644
index bbccb39338..0000000000
--- a/testsuites/LLT/compiler/CheckedExceptions/parse/decl_multiple_clauses.cj
+++ /dev/null
@@ -1,61 +0,0 @@
-// Checked exceptions (capability parameters in declarations): a declaration may carry several `throws`
-// clauses; their entries union into one list. This serves generated code -- a macro appends a clause
-// instead of merging into an existing one -- and conditional compilation. `captures` unions the same way.
-// Positive: every form parses, the unioned lists are what the bodies are checked against, and it runs.
-
-// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
-// EXEC: %run %output
-
-class AException <: Exception {}
-class BException <: Exception {}
-class CException <: Exception {}
-class DException <: Exception {}
-
-// two clauses, the second carrying several entries
-func step() throws AException throws BException, CException {
-    throw AException()
-}
-
-// a `where` block may sit between the clauses, in either order
-func generic<T>(x: T) throws AException where T <: ToString throws BException {
-    throw BException()
-}
-
-// unioned lists are what call sites must satisfy: all three entries are required here
-func callStep() throws AException, BException, CException {
-    step()
-}
-
-// `...` may repeat across the clauses of one declaration, idempotently: any occurrence opens
-// the combined list to inference, so the DException thrown below needs no explicit entry
-func opened() throws AException, ... throws BException, ... {
-    throw AException()
-}
-
-func callOpened() throws AException, BException {
-    opened()
-}
-
-// captures unions the same way; entries follow the `throws` entry rules, aliases included
-type Two = (CException, DException)
-
-class Multi captures AException captures BException, Two {
-    init() {}
-    func a() { throw AException() }
-    func b() { throw BException() }
-    func c() { throw CException() }
-    func d() { throw DException() }
-}
-
-main() {
-    try {
-        callStep()
-        callOpened()
-        generic(1)
-    } catch (e: Exception) {}
-    try {
-        let m = Multi()
-        m.a()
-    } catch (e: Exception) {}
-    return 0
-}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/neg_duplicate_clause.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_duplicate_clause.cj
new file mode 100644
index 0000000000..491a5549d7
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_duplicate_clause.cj
@@ -0,0 +1,27 @@
+// Checked exceptions: a declaration carries at most one clause of each kind, exactly as it carries
+// one `where` block; a second is an error. Generated code that adds requirements merges entries into
+// the existing clause, which also preserves its inference status -- appending a clause could flip it.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: duplicate 'throws' clause
+// ASSERT: scan error: duplicate 'captures' clause
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func f(): Unit throws AException throws BException {
+    throw AException()
+}
+
+// a `where` block between the two does not make a second clause legal either
+func g<T>(x: T): Unit throws AException where T <: ToString throws BException {
+    throw AException()
+}
+
+class Twice captures AException captures BException {
+    init() {}
+}
+
+main() {
+    return 0
+}

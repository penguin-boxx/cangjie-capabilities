diff --git a/testsuites/LLT/compiler/CheckedExceptions/captures/captures_empty_and_ctor_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/captures/captures_empty_and_ctor_neg.cj
new file mode 100644
index 0000000000..03dfb12a46
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/captures/captures_empty_and_ctor_neg.cj
@@ -0,0 +1,28 @@
+// Checked exceptions (capability capturing rules 1 and 2): a `captures` clause that is statically
+// empty -- written `()`, or an alias that expands to nothing -- is equivalent to omitting it, so
+// `Empty` below is an ordinary non-capturing class. A capturing type, by contrast, has no implicit
+// default constructor: every constructor requires the captured capabilities at its call site, so
+// there must be one to carry the requirement.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: class 'NoCtor' has a 'captures' clause and must declare an 'init' constructor
+
+class FileException <: Exception {}
+
+// statically empty: not capturing, so the ordinary constructor rules apply
+class Empty
+captures () {
+    Empty(let x: Int64) {} // a primary constructor is fine here
+}
+
+class NoCtor
+captures FileException {
+    public func write(s: String): Unit {
+        throw FileException()
+    }
+}
+
+main() {
+    let e = Empty(1)
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/captures/captures_subclass.cj b/testsuites/LLT/compiler/CheckedExceptions/captures/captures_subclass.cj
new file mode 100644
index 0000000000..f00ebfa196
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/captures/captures_subclass.cj
@@ -0,0 +1,65 @@
+// Checked exceptions (capability capturing rule 4): a subclass restates coverage of the superclass's
+// captured types and adds its own. Its constructor implicitly requires its own list at the call
+// site, and the `super` call resolves the superclass's requirement from the class capture scope like
+// any other call -- so the covering entry serves both. A more general entry covers a narrower one.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+open class FileException <: Exception {}
+class MissingFileException <: FileException {}
+class AuditException <: Exception {}
+
+open class Base
+captures FileException {
+    init() {}
+
+    public open func write(s: String): Unit {
+        throw FileException()
+    }
+}
+
+class Audited <: Base
+captures AuditException, FileException {
+    init() { super() }
+
+    public override func write(s: String): Unit {
+        audit(s)          // the captured AuditException capability
+        super.write(s)    // and the superclass's own business
+    }
+
+    func audit(s: String): Unit {
+        throw AuditException()
+    }
+}
+
+// a more general entry covers the superclass's narrower one
+open class Narrow
+captures MissingFileException {
+    init() {}
+}
+
+class Wider <: Narrow
+captures FileException {
+    init() { super() }
+}
+
+main(): Int64 {
+    var caught = 0
+    try {
+        let a = Audited()   // requires AuditException and FileException here
+        a.write("x")
+    } catch (e: AuditException) {
+        caught++
+    } catch (e: FileException) {
+        caught++
+    }
+    try {
+        let w = Wider()     // requires FileException, which covers MissingFileException
+        if (caught == 0) {
+            return 1
+        }
+    } catch (e: FileException) {
+    }
+    return 0
+}

diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_dots_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_dots_neg.cj
new file mode 100644
index 0000000000..a882daa056
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_dots_neg.cj
@@ -0,0 +1,18 @@
+// Effect requirements are never inferred -- every 'performs' list is written -- so the '...' marker,
+// which opens an exception list to inference, has nothing to open on a 'performs' clause.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: '...' is not allowed in a 'performs' clause
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+
+func f(): Int64
+performs GetNumber, ... {
+    perform GetNumber()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/performs/performs_without_chexc.cj b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_without_chexc.cj
new file mode 100644
index 0000000000..077b05ae33
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/performs/performs_without_chexc.cj
@@ -0,0 +1,25 @@
+// Effect requirements follow the effect-handler feature, on an axis of its own: wherever that
+// feature is enabled, a 'perform' with no handler is an error at every exception-checking level --
+// there is no migration level for it, since an unhandled 'perform' fails at run time. Exception
+// requirements, in the same compilation, impose nothing while checking is off.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetNumber'
+// ASSERT: scan Handler<Class-GetNumber>
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+class AException <: Exception {}
+
+func undeclared(): Int64 {
+    perform GetNumber() // error: effects are checked whenever handlers are enabled
+}
+
+func mayThrow(): Unit throws AException {
+    throw AException() // fine: exception checking is off, the clause imposes nothing
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/captures_command.cj b/testsuites/LLT/compiler/CheckedExceptions/types/captures_command.cj
new file mode 100644
index 0000000000..123e04f117
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/captures_command.cj
@@ -0,0 +1,34 @@
+// Checked exceptions x effect handlers: a 'captures' clause may name commands as well. An instance
+// captures the handler capabilities its methods need exactly as it captures exception ones, and its
+// constructor requires them at the construction site.
+
+// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-GetNumber'
+// ASSERT: scan Handler<Class-GetNumber>
+
+import stdx.effect.*
+
+class GetNumber <: Command<Int64> {}
+
+class Holder captures GetNumber {
+    init() {}
+
+    // the captured handler capability is in scope in a receiver body: no clause needed
+    func value(): Int64 {
+        perform GetNumber()
+    }
+}
+
+func makeUnhandled(): Holder {
+    Holder() // error: the construction site must supply the captured handler capability
+}
+
+main() {
+    try {
+        let h = Holder() // ok: the handle clause below supplies it
+        h.value()
+    } handle (_: GetNumber) {
+        resume with 42
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/clause_unchecked_bound_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/types/clause_unchecked_bound_neg.cj
new file mode 100644
index 0000000000..37c5ce1259
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/clause_unchecked_bound_neg.cj
@@ -0,0 +1,22 @@
+// Checked exceptions (capability list aliases, rule 2): a type parameter is admitted in a clause --
+// a requirement that instantiates to an unchecked type is trivially satisfied instead -- unless its
+// own bound is unchecked, in which case every instantiation of it is, and the entry can never
+// require a capability.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: unchecked exception type 'T' is not allowed in a 'throws' clause
+// ASSERT: scan error: unchecked exception type 'U' is not allowed in a 'throws' clause
+
+class MyUnchecked <: UncheckedException {}
+
+func f<T>(): Unit throws T where T <: MyUnchecked {}
+
+func g<U>(): Unit throws U where U <: UncheckedException {}
+
+func ok<E>(e: E): Unit throws E where E <: Exception { // admitted: may instantiate either way
+    throw e
+}
+
+main() {
+    return 0
+}

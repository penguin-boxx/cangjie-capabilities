diff --git a/testsuites/LLT/compiler/CheckedExceptions/assume/assume_empty_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_empty_neg.cj
new file mode 100644
index 0000000000..604c1f8ddb
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_empty_neg.cj
@@ -0,0 +1,13 @@
+// Checked exceptions (assumption imports): the empty list is rejected -- an assumption that assumes
+// nothing is either a mistake or the bare form written the long way, and the bare form already
+// means 'Exception'.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: '@AssumeThrows[]' assumes nothing
+
+@AssumeThrows[]
+import std.collection.*
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_neg.cj
new file mode 100644
index 0000000000..53397da0ae
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_neg.cj
@@ -0,0 +1,18 @@
+// Checked exceptions (assumption imports): the claim is package-scoped -- one annotated import binds
+// every call into that dependency from the whole consuming package, whether or not the calling file
+// repeats the annotation. Here the annotation is in this file and the call is in the other one,
+// which pins an empty list, so the assumed requirement has nowhere to go and is reported there.
+
+// DEPENDENCE: legacy_db.cj assume_package_scope_other.cj
+// EXEC: %compiler %cmp_opt %compile_lib_opt legacy_db.cj -o legacy_db.%middle
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions legacy_db.%middle %n.cj assume_package_scope_other.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-SqlException'
+
+@AssumeThrows[SqlException]
+import legacy_db.*
+
+public class SqlException <: Exception {}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_other.cj b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_other.cj
new file mode 100644
index 0000000000..09be70a451
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/assume/assume_package_scope_other.cj
@@ -0,0 +1,8 @@
+// Support file for assume_package_scope_neg.cj: the same package, a plain import, and a callable
+// that pins an empty capability list. The assumption written in the other file reaches this call.
+
+import legacy_db.*
+
+func inOtherFile(): Int64 throws () {
+    query("select 1")
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_inert.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_inert.cj
new file mode 100644
index 0000000000..86f58809a1
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/flagoff_clause_inert.cj
@@ -0,0 +1,31 @@
+// Checked exceptions (compatibility): the clause grammar is unconditional -- every clause position
+// is a parse error in the language without them, so recognizing the soft keywords there changes no
+// valid program. What the flag decides is what the clauses mean: with checking off they impose no
+// obligations, so the undeclared throw below is accepted exactly as it is today.
+
+// EXEC: %compiler %cmp_opt %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+class BException <: Exception {}
+
+func declared() throws AException {
+    throw AException()
+}
+
+func undeclared(): Unit { // no clause, and no obligation without checking
+    throw BException()
+}
+
+class Capturing captures AException {
+    init() {}
+    func use(): Unit { declared() }
+}
+
+main() {
+    try {
+        declared()      // no capability needed: checking is off
+        undeclared()
+    } catch (e: Exception) {}
+    return 0
+}

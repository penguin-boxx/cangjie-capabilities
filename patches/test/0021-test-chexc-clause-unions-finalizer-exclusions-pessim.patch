diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_clause_combined.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_clause_combined.cj
new file mode 100644
index 0000000000..277233d530
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_clause_combined.cj
@@ -0,0 +1,20 @@
+// Checked exceptions: `throws ()` is an authoritative empty list -- it pins the callable as requiring
+// no capabilities. Combining it with another `throws` clause of the same declaration contradicts the
+// pin and is an error, even though several non-empty clauses union freely.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: an empty 'throws' clause cannot be combined with another clause of the same kind
+
+class AException <: Exception {}
+
+func f() throws () throws AException {
+    throw AException()
+}
+
+func g() throws AException throws () {
+    throw AException()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_list_mixed.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_list_mixed.cj
new file mode 100644
index 0000000000..e291cf2ac1
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_empty_list_mixed.cj
@@ -0,0 +1,19 @@
+// Checked exceptions: `()` is the empty entry list and is legal only as the whole list -- neither
+// nested in nor mixed with other entries.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: '()' is only allowed as the whole capability list
+
+class AException <: Exception {}
+
+func mixed() throws AException, () {
+    throw AException()
+}
+
+func nested() throws ((), AException) {
+    throw AException()
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/parse/neg_finalizer_clause.cj b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_finalizer_clause.cj
new file mode 100644
index 0000000000..077f70827d
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/parse/neg_finalizer_clause.cj
@@ -0,0 +1,22 @@
+// Checked exceptions (capability parameters in declarations): no capability scope encloses a
+// finalizer -- it may run long after the handlers that supplied the capabilities are gone -- so a
+// finalizer carries no `throws` clause. The scope side of the rule is in scopes/neg_finalizer.cj.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan error: a 'throws' clause is not allowed on a finalizer
+
+class AException <: Exception {}
+
+func mkA() throws AException {
+    throw AException()
+}
+
+class WithClause {
+    ~init() throws AException {
+        mkA()
+    }
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/scopes/neg_finalizer.cj b/testsuites/LLT/compiler/CheckedExceptions/scopes/neg_finalizer.cj
new file mode 100644
index 0000000000..cdf5d016bd
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/scopes/neg_finalizer.cj
@@ -0,0 +1,41 @@
+// Checked exceptions (capability scopes): no capability scope encloses a finalizer. It is therefore
+// not inference-eligible -- a checked throw inside one has nothing to discharge it -- and the
+// captured capabilities of a capturing class do not reach it either. The clause side of the rule is
+// in parse/neg_finalizer_clause.cj.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-BException'
+// ASSERT: scan Cannot find a capability for 'Class-CException'
+
+class BException <: Exception {}
+class CException <: Exception {}
+
+func mkB() throws BException {
+    throw BException()
+}
+
+func mkC() throws CException {
+    throw CException()
+}
+
+class Inferred {
+    ~init() { // error: a finalizer is not inference-eligible, so nothing discharges mkB
+        mkB()
+    }
+}
+
+class Capturing captures CException {
+    init() {}
+
+    func use() {
+        mkC() // ok: a receiver body is covered by the captures scope
+    }
+
+    ~init() { // error: the captured capability does not reach a finalizer
+        mkC()
+    }
+}
+
+main() {
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic.cj b/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic.cj
new file mode 100644
index 0000000000..3412970a5c
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic.cj
@@ -0,0 +1,77 @@
+// Checked exceptions (reflection and runtime casts): a runtime type test sees the erased shape and
+// cannot verify a capability list, so a cast target is read pessimistically, by position: a function
+// type in a covariant position receives `throws Exception`, one in a contravariant position keeps the
+// empty list it spells. Positive: the requirement the cast hands back is dischargeable, and the
+// contravariant positions stay clause-free.
+
+// EXEC: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output
+// EXEC: %run %output
+
+class AException <: Exception {}
+
+func throwing() throws AException {
+    throw AException()
+}
+
+func plain(): Unit {}
+
+// contravariant: the callback the value receives keeps the empty list, so a clause-free lambda fits
+func higherOrder(f: () -> Unit): Unit {
+    f()
+}
+
+// covariant through a result: the returned function is read as requiring a capability
+func returning(): () -> Unit {
+    return plain
+}
+
+main() {
+    let asAny: Any = throwing
+    var ran = 0
+    try {
+        // `() throws Exception -> Unit`: the requirement is real and is discharged here
+        match (asAny as (() -> Unit)) {
+            case Some(g) => g()
+            case None => ran++
+        }
+    } catch (e: AException) {
+        ran++
+    } catch (e: Exception) {
+        ran++
+    }
+
+    let hoAny: Any = higherOrder
+    try {
+        match (hoAny as ((() -> Unit) -> Unit)) {
+            case Some(h) => h(plain) // the parameter stayed clause-free: a plain function fits
+            case None => ran++
+        }
+    } catch (e: Exception) {
+        ran++
+    }
+
+    let retAny: Any = returning
+    try {
+        match (retAny as (() -> (() -> Unit))) {
+            case Some(r) => r()() // both arrows are covariant: both require a capability
+            case None => ran++
+        }
+    } catch (e: Exception) {
+        ran++
+    }
+
+    // type patterns read the same way
+    try {
+        match (asAny) {
+            case g: () -> Unit => g()
+            case _ => ran++
+        }
+    } catch (e: Exception) {
+        ran++
+    }
+
+    if (ran == 1) {
+        return 0
+    }
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic_neg.cj
new file mode 100644
index 0000000000..b4726bf658
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/cast_pessimistic_neg.cj
@@ -0,0 +1,33 @@
+// Checked exceptions (reflection and runtime casts): the pessimistic reading of a cast target is a
+// real requirement -- using the cast value where nothing discharges it is an error, which is exactly
+// the laundering the rule closes. The rejected targets are in types/cast_target_neg.cj.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan Cannot find a capability for 'Class-Exception'
+
+class AException <: Exception {}
+
+func throwing() throws AException {
+    throw AException()
+}
+
+public func callCast(x: Any): Unit {
+    // the cast hands back `() throws Exception -> Unit`: nothing here discharges it
+    match (x as (() -> Unit)) {
+        case Some(g) => g()
+        case None => ()
+    }
+}
+
+public func patternBinding(x: Any): Unit {
+    match (x) {
+        case g: () -> Unit => g() // same requirement through a type pattern
+        case _ => ()
+    }
+}
+
+main() {
+    callCast(throwing)
+    patternBinding(throwing)
+    return 0
+}
diff --git a/testsuites/LLT/compiler/CheckedExceptions/types/cast_target_neg.cj b/testsuites/LLT/compiler/CheckedExceptions/types/cast_target_neg.cj
new file mode 100644
index 0000000000..3e1e3a4088
--- /dev/null
+++ b/testsuites/LLT/compiler/CheckedExceptions/types/cast_target_neg.cj
@@ -0,0 +1,43 @@
+// Checked exceptions (reflection and runtime casts): a type argument of a generic is invariant --
+// CangJie has no declaration-site variance -- so a function type inside one has no sound reading and
+// the target is rejected. Targets are written without clauses: the reading decides them.
+
+// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-chexc %n.cj -o %output 2>&1 | compare %f
+// ASSERT: scan cannot be a runtime cast target: it has a function type in an invariant position
+// ASSERT: scan error: a capability clause is not allowed in a runtime cast target
+
+import std.collection.*
+
+class AException <: Exception {}
+
+func invariantTarget(x: Any): Unit {
+    match (x as ArrayList<() -> Unit>) {
+        case Some(_) => ()
+        case None => ()
+    }
+}
+
+func optionTarget(x: Any): Unit {
+    match (x as Option<() -> Unit>) {
+        case Some(_) => ()
+        case None => ()
+    }
+}
+
+func arrayPattern(x: Any): Unit {
+    match (x) {
+        case _: Array<() -> Unit> => ()
+        case _ => ()
+    }
+}
+
+func writtenClause(x: Any): Unit {
+    match (x as (() throws AException -> Unit)) {
+        case Some(_) => ()
+        case None => ()
+    }
+}
+
+main() {
+    return 0
+}

 {
     // Checked exceptions: the declaration's 'throws' clause types (elaborated during PreCheck's
@@ -272,12 +325,7 @@ std::vector<Ptr<Ty>> GetFuncBodyCapTys(const FuncBody& fb)
     if (!fb.throwsClause || isCLike) {

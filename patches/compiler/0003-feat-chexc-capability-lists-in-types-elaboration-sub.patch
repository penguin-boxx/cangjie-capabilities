+        return {};
+    }
+    std::vector<Ptr<Ty>> ret;
+    for (auto& capType : fb.throwsClause->capTypes) {
+        CJC_NULLPTR_CHECK(capType);
+        ret.emplace_back(Ty::IsInitialTy(capType->GetTy()) ? TypeManager::GetInvalidTy() : capType->GetTy());
+    }
+    return ret;
+}

From 5de33983260a64c52037d11de1ee66de6674c58e Mon Sep 17 00:00:00 2001
From: Andrey Stoyan <andrey.stoyan.csam@gmail.com>
Date: Sun, 30 Aug 2026 17:28:10 +0300
Subject: [PATCH 40/44] docs(chexc): the assumption map is keyed by package,
 not by file

The comment described the file-scoped design an earlier decision (D15) took; the revised text
rules assumption imports package-scoped -- "the annotation applies to every call into the
dependency from the whole consuming package, whether or not the calling file repeats it" -- and
the code has followed the text for some time. Only the comment lagged.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/Sema/CapabilityCheck/CapabilityCheck.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/Sema/CapabilityCheck/CapabilityCheck.cpp b/src/Sema/CapabilityCheck/CapabilityCheck.cpp
index c925f2f4..1a4742b6 100644
--- a/src/Sema/CapabilityCheck/CapabilityCheck.cpp
+++ b/src/Sema/CapabilityCheck/CapabilityCheck.cpp
@@ -985,7 +985,9 @@ private:
     TypeManager& typeManager;
     const ImportManager& importManager;
     Sema::CapabilityMissHandler& missHandler;
-    /// Assumption imports of the package being checked, indexed by the file they appear in.
+    /// Assumption imports of the package being checked, indexed by the package they name. The
+    /// annotation is package-scoped -- "the annotation applies to every call into the dependency
+    /// from the whole consuming package" -- so the file that wrote the import does not narrow it.
     const AssumedThrows& assumed;
     std::vector<SupplyScope> supplies;
     RootSupply rootSupply;
-- 

+/**
+ * @file
+ *
+ * This file declares what a loaded package's capability metadata says about it.
+ */
+
+#ifndef CANGJIE_MODULES_PACKAGECAPABILITYINFO_H
+#define CANGJIE_MODULES_PACKAGECAPABILITYINFO_H
+
+#include <cstdint>
+
+namespace Cangjie {
+/**
+ * Checked exceptions: what a loaded package's capability metadata is worth to its consumers.
+ * The defaults describe a package produced before the feature existed: nothing recorded, so an
+ * empty capability list means "unknown", not "requires nothing".
+ */
+struct PackageCapabilityInfo {
+    enum class Level : uint8_t { OFF, WARN, ERROR };
+    Level level{Level::OFF};         /**< Severity capability checking ran at, 'OFF' if it did not. */
+    bool effectsEnabled{false};      /**< Whether effect handlers were enabled for the package. */
+    bool recordsCapabilities{false}; /**< Whether the package carries capability metadata at all. */
+};
+} // namespace Cangjie
+
+#endif // CANGJIE_MODULES_PACKAGECAPABILITYINFO_H
diff --git a/schema/ModuleFormat.fbs b/schema/ModuleFormat.fbs
index a841ac21..009d7ead 100644
--- a/schema/ModuleFormat.fbs
+++ b/schema/ModuleFormat.fbs
@@ -688,9 +688,26 @@ enum OptimizationLevel : uint8 {
   O0, O1, O2, O3, Os, Oz
 }
 
+/// Checked exceptions: the severity capability checking ran at when the package was compiled.
+/// 'Off' also covers every package produced before the feature existed, which is what the default
+/// gives an old '.cjo'.
+enum ChexcLevel : byte {
+  Off = 0,
+  Warn,
+  Error
+}
+
 table CompilationOptions {
   optimization_level: OptimizationLevel;
   debug: bool;
+  // Checked exceptions: what the capability lists in this package are worth. 'chexc_level' says
+  // whether they were verified and how strictly; 'effects_enabled' says whether effect handlers
+  // were on, so an empty 'performs' list means "performs nothing" rather than "was not recorded";
+  // 'records_capabilities' distinguishes a package this compiler produced from one that predates
+  // capability metadata entirely, which the two enums above cannot express on their own.
+  chexc_level: ChexcLevel = Off;
+  effects_enabled: bool = false;
+  records_capabilities: bool = false;
 }
 

diff --git a/src/Modules/ASTSerialization/ASTWriterImpl.h b/src/Modules/ASTSerialization/ASTWriterImpl.h
index ca6fab12..8cb9f16a 100644
--- a/src/Modules/ASTSerialization/ASTWriterImpl.h
+++ b/src/Modules/ASTSerialization/ASTWriterImpl.h
@@ -19,6 +19,7 @@
 
 #include "cangjie/AST/ASTCasting.h"
 #include "cangjie/Modules/ASTSerialization.h"

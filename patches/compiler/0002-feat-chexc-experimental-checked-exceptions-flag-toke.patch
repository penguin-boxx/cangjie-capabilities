+        throwsClause;          /**< Checked-exception `throws` clause (experimental). Generated by parser, Optional */
+    OwnedPtr<Block> body;      /**< Body of the function. Generated by parser */
+    OwnedPtr<Generic> generic; /**< Generated by parser, Optional */

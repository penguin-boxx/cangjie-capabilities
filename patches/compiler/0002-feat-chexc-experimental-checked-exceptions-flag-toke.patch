+/**
+ * A ThrowsClause node represents a checked-exception capability clause (experimental, behind
+ * `--experimental --enable-chexc`): `throws E`, `throws (E1, E2)`, `throws ()`; declarations
+ * additionally allow the bare list form `throws E1, E2`.
+ */
+struct ThrowsClause : Node {
+    Position throwsPos;                   /**< Position of the `throws` keyword. Generated by parser */
+    Position leftParenPos;                /**< Position of '('. Optional, zero for the bare form. */
+    std::vector<OwnedPtr<Type>> capTypes; /**< Capability (exception) types. Generated by parser */
+    std::vector<Position> commaPosVector; /**< Positions of ','. Generated by parser */
+    Position rightParenPos;               /**< Position of ')'. Optional, zero for the bare form. */
+    ThrowsClause() : Node(ASTKind::THROWS_CLAUSE)
+    {
+    }
+};
+
 /**
  * A FuncType node represents a function type, example: `(Int32, Int32)->Int32`, @p paramType is (Int32, Int32), @p
  * retType is Int32.
@@ -880,6 +896,7 @@ struct FuncType : Type {
